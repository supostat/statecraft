<h1>My orders</h1>

<% if @orders.empty? %>
  <p class="muted">No orders yet — <%= link_to "browse the store", products_path %>.</p>
<% else %>
  <table>
    <thead>
      <tr><th>order</th><th>status</th><th class="num">total</th></tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= link_to order.number, my_order_path(order) %></td>
          <td><%= render "status", order: order %></td>
          <td class="num"><%= price(order.total_cents) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
