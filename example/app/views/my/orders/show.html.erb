<div class="order-head">
  <div class="title-row">
    <h1>Order <%= @order.number %></h1>
    <%= render "status", order: @order %>
  </div>
  <% if @order.is_a?(CreditOrder) || @order.express? %>
    <p class="modifiers">
      <% if @order.is_a?(CreditOrder) %>· paid on credit<% end %>
      <% if @order.express? %>· express delivery<% end %>
    </p>
  <% end %>
  <% if @order.shipment %>
    <p class="delivery-line">Delivery: <strong><%= shipping_status(@order.shipment) %></strong></p>
  <% end %>
</div>

<table>
  <thead>
    <tr><th>item</th><th class="num">qty</th><th class="num">price</th><th class="num">line</th></tr>
  </thead>
  <tbody>
    <% @order.items.includes(:product).each do |item| %>
      <tr>
        <td><%= item.product.name %></td>
        <td class="num"><%= item.quantity %></td>
        <td class="num"><%= price(item.unit_price_cents) %></td>
        <td class="num"><%= price(item.line_total_cents) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p class="total-line"><strong>Total: <%= price(@order.total_cents) %></strong></p>

<% if @order[:state] == "pending" %>
  <% if can?(:pay, @order) && @order.payment.nil? %>
    <%= button_to "Pay", pay_my_order_path(@order), method: :post, class: "transition-button" %>
  <% end %>

  <% if can?(:cancel, @order) && @order.offerable_events.include?(:cancel) %>
  <%= form_with url: cancel_my_order_path(@order), method: :post, local: true do %>
    <fieldset>
      <legend>Changed your mind?</legend>
      <label>
        Reason
        <input type="text" name="metadata[reason]">
      </label>
      <button type="submit" class="preview-button">Cancel the order</button>
    </fieldset>
  <% end %>
  <% end %>
<% end %>
