<h1>Admin · Shipments</h1>

<% if @shipments.empty? %>
  <p class="empty-state">No shipments yet.</p>
<% else %>
<table>
  <thead>
    <tr><th>number</th><th>order</th><th>kind</th><th>state</th></tr>
  </thead>
  <tbody>
    <% @shipments.each do |shipment| %>
      <tr>
        <td><%= link_to shipment.number, admin_shipment_path(shipment) %></td>
        <td><%= link_to shipment.order.number, admin_order_path(shipment.order) %></td>
        <td><%= shipment.express? ? "express" : "regular" %></td>
        <td><code><%= shipment[:state] %></code></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% end %>
