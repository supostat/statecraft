<h1>Payment <%= @payment.number %></h1>

<p>
  State: <code><%= @payment[:state] %></code>
  · amount: <%= @payment.amount_cents %>c
</p>

<%= form_with url: save_and_capture_payment_path(@payment), method: :post, local: true do %>
  <fieldset>
    <legend>Edit and act</legend>
    <label>
      amount_cents
      <input type="number" name="payment[amount_cents]" value="<%= @payment.amount_cents %>">
    </label>
  </fieldset>

  <%= render "shared/transition_buttons",
             machine: PaymentFlow,
             state: @payment[:state],
             fire_url: ->(event_name) { public_send("#{event_name}_payment_path", @payment) } %>

  <button type="submit" class="preview-button">save and capture</button>
<% end %>

<%= render "shared/history", record: @payment %>
