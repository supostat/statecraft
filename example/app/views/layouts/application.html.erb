<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>statecraft example</title>
    <%= csrf_meta_tags %>
    <link rel="stylesheet" href="/application.css">
    <script src="/app.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href="/">statecraft store</a>
        <a href="/products">Store</a>
        <a href="/cart">Cart</a>
        <a href="/my/orders">My orders</a>
        <% if can? :access, :admin_zone %>
          <span class="muted">admin:</span>
          <a href="/admin/orders">Orders</a>
          <a href="/admin/payments">Payments</a>
          <a href="/admin/shipments">Shipments</a>
          <a href="/admin/operations">Operations log</a>
        <% end %>
        <%= form_with url: switch_user_path, method: :post, local: true,
                      class: "user-switcher", data: { autosubmit: true } do %>
          <span class="muted">you are:</span>
          <select name="user_id">
            <% User.order(:id).each do |user| %>
              <option value="<%= user.id %>" <%= "selected" if user == current_user %>>
                <%= user.name %> (<%= user.role %>)
              </option>
            <% end %>
          </select>
          <button type="submit" class="switch-button">Switch</button>
        <% end %>
      </nav>
    </header>

    <% flash.each do |kind, message| %>
      <div class="flash flash-<%= kind %>"><%= message %></div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
