<h1>Shipments</h1>

<table>
  <thead>
    <tr><th>number</th><th>kind</th><th>state</th></tr>
  </thead>
  <tbody>
    <% @shipments.each do |shipment| %>
      <tr>
        <td><%= link_to shipment.number, shipment_path(shipment) %></td>
        <td><%= shipment.express? ? "express" : "regular" %></td>
        <td><code><%= shipment[:state] %></code></td>
      </tr>
    <% end %>
  </tbody>
</table>
